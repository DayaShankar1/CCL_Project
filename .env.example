# Frontend (Vite) configuration. Do not commit a real .env file.
# VITE_ variables are included in the browser build. Use only Supabase's
# publishable/anon key here — never a service-role or other private key.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# URL of the separately deployed Express API (no trailing slash).
VITE_API_BASE_URL="http://localhost:5001"
